TZ=UTC
PORT=3334
HOST=localhost
APP_NAME=Context Engine
APP_URL=http://${HOST}:${PORT}
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# Location of the "mutators" drive disk (relative to the app root)
MUTATORS_PATH=storage/mutators
# Passes after which mutators re-triggering each other are treated as an infinite loop
MAX_MUTATOR_PASSES=10

# Context versions are stored in their own database (not the web app's)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=context_engine
