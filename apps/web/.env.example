TZ=UTC
PORT=3333
HOST=localhost
APP_NAME=ONVEP MCR
APP_URL=http://${HOST}:${PORT}
LOG_LEVEL=info
DRIVE_DISK=fs
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

RESEND_API_KEY=<your-key>
EMAIL_FROM=admin@repo.com

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=user@host.com
SMTP_PASSWORD='XXX'
SMTP_SECURE=0
SMTP_REJECTUNAUTHORIZED=false

VITE_API_URL=http://localhost:3333

# Context engine (apps/context-engine). The public URL is the one browsers use
# for SSE, defaults to CONTEXT_ENGINE_URL.
CONTEXT_ENGINE_URL=http://localhost:3334
CONTEXT_ENGINE_PUBLIC_URL=

# Node-RED editor (docker compose `node-red` service), linked from the profile menu.
# Empty: no link.
NODE_RED_URL=http://localhost:1880
LIMITER_STORE=database
# Production only (docker-compose.prod.yaml, behind an existing Traefik v3).
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# APP_DOMAIN=mcr.example.com
# CONTEXT_ENGINE_DOMAIN=engine.mcr.example.com
# NODE_RED_DOMAIN=node-red.mcr.example.com
# htpasswd line, single-quoted (keeps the `$`): htpasswd -nB admin
# NODE_RED_BASIC_AUTH='admin:$2y$05$...'
# IPs / CIDRs (comma-separated) allowed to write to the context engine from outside, e.g.
# the Companion machines. Default: none.
# CONTEXT_ENGINE_WRITE_ALLOWED_IPS=203.0.113.10/32
