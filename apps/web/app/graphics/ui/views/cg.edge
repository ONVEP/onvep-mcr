<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    {{-- Served locally: playout machines are often offline. Compiles Tailwind classes at runtime. --}}
    <script src="/cg/assets/tailwind.js"></script>
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        {{-- Transparent so playout software (CasparCG, OBS…) can key the graphics. --}}
        background: transparent;
      }
      .cg-layer {
        position: absolute;
        inset: 0;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    @each(layer in layers)
      <div class="cg-layer" data-layer="{{ layer.slug }}">{{{ layer.content }}}</div>
    @end
  </body>
</html>
