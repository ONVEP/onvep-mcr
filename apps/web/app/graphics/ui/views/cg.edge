<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    {{-- Served locally: playout machines are often offline. Compiles Tailwind classes at runtime. --}}
    <script src="/cg/assets/tailwind.js"></script>
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: transparent;
      }
      .cg-layer {
        position: absolute;
        inset: 0;
        overflow: hidden;
      }
    </style>
    @if(cssVariables.length)
      {{-- Values are validated on save so they can't break out of the declaration. --}}
      <style>

                :root {
                  @each(variable in cssVariables)
                    {{ variable.property }}: {{{ variable.value }}};
                  @end
                }

      </style>
      {{-- Also declared to Tailwind so colors get their utilities (bg-<name>, text-<name>…). --}}
      <style type="text/tailwindcss">

                @theme {
                  @each(variable in cssVariables)
                    @if(variable.kind === 'color')
                      {{ variable.property }}: {{{ variable.value }}};
                    @end
                  @end
                }

      </style>
    @end
  </head>
  <body>
    @each(layer in layers)
      <div class="cg-layer" data-layer="{{ layer.slug }}">{{{ layer.content }}}</div>
    @end
  </body>
</html>
