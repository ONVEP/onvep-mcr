# Portainer stack variables (Environment variables → Advanced mode): paste, then fill in.

# Images (pnpm deploy:prod). TAG: a commit hash to pin a version, else latest.
REGISTRY=registry.example.com/onvep
TAG=latest

# Traefik already running on the server
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

APP_DOMAIN=mcr.example.com
CONTEXT_ENGINE_DOMAIN=engine.mcr.example.com
NODE_RED_DOMAIN=node-red.mcr.example.com

# Random secrets, e.g. `openssl rand -base64 32`. Don't change them once set.
APP_KEY=
CONTEXT_ENGINE_APP_KEY=

DB_USER=onvep
DB_PASSWORD=
DB_DATABASE=app

# Mail
EMAIL_FROM=mcr@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REJECTUNAUTHORIZED=true
RESEND_API_KEY=unused

# Node-RED login, without `$` (Portainer would expand it): htpasswd -nbs admin 'password'
NODE_RED_BASIC_AUTH=admin:{SHA}...

# IPs / CIDRs (comma-separated) allowed to write to the context engine from outside, e.g.
# the Companion machines. Default: none.
CONTEXT_ENGINE_WRITE_ALLOWED_IPS=127.0.0.1/32

LOG_LEVEL=info
TZ=Europe/Zurich
